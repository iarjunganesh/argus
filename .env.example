# ─────────────────────────────────────────────
# ARGUS — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── Runtime choices ───────────────────────────
# Where ARGUS reads data: local (synthetic data in data/, no cloud account) or azure.
ARGUS_DATA_BACKEND=local
# Folder the local backend reads. Defaults to the repository's data/ folder.
# ARGUS_DATA_DIR=
# Which language model writes the explanation: none, azure-openai, openai or github-models.
ARGUS_MODEL_PROVIDER=none
# Model name for openai and github-models. Azure OpenAI uses AZURE_OPENAI_DEPLOYMENT instead.
# ARGUS_MODEL=
# Browser origins allowed to call the API, comma-separated. Empty allows none.
ARGUS_CORS_ORIGINS=

# ── Azure OpenAI (ARGUS_MODEL_PROVIDER=azure-openai) ──
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# ── OpenAI (ARGUS_MODEL_PROVIDER=openai) ──────
# OPENAI_API_KEY=<your-key>

# ── GitHub Models (ARGUS_MODEL_PROVIDER=github-models) ──
GITHUB_TOKEN=<your-github-pat>

# ── Azure resource group (used by the infra/ scripts) ──
AZURE_RESOURCE_GROUP=argus-rg

# ── Azure AI Search (ARGUS_DATA_BACKEND=azure) ──
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-key>

# ── Search index names, one per knowledge base ──
FOUNDRY_IQ_KB_REGULATIONS=argus-kb-regulations
FOUNDRY_IQ_KB_SANCTIONS=argus-kb-sanctions
FOUNDRY_IQ_KB_ADVERSEMEDIA=argus-kb-adversemedia

# ── Azure Cosmos DB (ARGUS_DATA_BACKEND=azure) ──
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_KEY=<your-key>
COSMOS_DATABASE=argus-db

# ── Azure Document Intelligence (ARGUS_DATA_BACKEND=azure) ──
DOC_INTELLIGENCE_ENDPOINT=https://<your-di>.cognitiveservices.azure.com
DOC_INTELLIGENCE_KEY=<your-key>

# ── Azure Blob Storage (OCR document assets) ─
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-storage>;AccountKey=<your-key>;EndpointSuffix=core.windows.net
OCR_STORAGE_CONTAINER=argus-ocr-docs
OCR_STORAGE_PREFIX=ocr-documents

# ── Agent A2A Endpoints ───────────────────────
IDENTITY_AGENT_URL=http://localhost:8001
SCREENING_AGENT_URL=http://localhost:8002
CORPORATE_AGENT_URL=http://localhost:8003
TRANSACTION_AGENT_URL=http://localhost:8004
COMPLIANCE_AGENT_URL=http://localhost:8005

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
